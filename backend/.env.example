# Copy this file to backend/.env and fill in real values.
# backend/.env is ignored by git, so never commit the filled-in copy.
#
# SECRET_KEY and MONGO_URI are required. The server stops at startup with a
# list of whatever is missing. Everything else is optional.

# Required. Flask JWT signing secret. Use a long random string, for example the
# output of: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Optional. Token lifetime in seconds, defaults to 3600
JWT_EXPIRATION=3600

# Optional. Google AI Studio key used by the incident classifier
GOOGLE_API_KEY=
# Optional. Gemini model used for classification, defaults to gemini-3.1-flash-lite
GEMINI_MODEL=

# Required. MongoDB Atlas connection string, including the database name
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/safesteps?retryWrites=true&w=majority

# Outgoing email for emergency contact alerts. With Gmail, SMTP_PASSWORD
# must be an app password, not the account password. Emails are skipped
# when SMTP_USER or SMTP_PASSWORD is empty.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional display address, defaults to SMTP_USER
SMTP_SENDER=
