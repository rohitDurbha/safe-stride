# Where the Flask backend lives. Leave it empty for local development, which
# uses http://127.0.0.1:5000. The Vercel build sets it to /api, where the backend function lives.
VITE_API_URL=

# CARTO basemaps key for the grey Positron and Dark Matter map tiles. Get one
# at https://dashboard.basemaps.carto.com and restrict it to your site's host.
# Without it the map falls back to OpenStreetMap tiles turned grey by CSS.
# Free for non-commercial use up to 5 million tile requests a month.
VITE_CARTO_API_KEY=
